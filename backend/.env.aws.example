# ============================================
# Neon PostgreSQL
# ============================================
DB_URL=jdbc:postgresql://YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD

# ============================================
# Spring Boot
# ============================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ============================================
# JWT
# ============================================
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# ============================================
# VNPay Sandbox
# ============================================
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://YOUR_EC2_PUBLIC_IP/api/vnpay/return
VNPAY_IPN_URL=

# ============================================
# Cloudinary
# ============================================
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ============================================
# Gmail SMTP
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_EMAIL
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# ============================================
# Frontend
# ============================================
FRONTEND_VERIFY_EMAIL_URL=http://YOUR_EC2_PUBLIC_IP/frontend/pages/verify-email-success.html

ESCROW_HOLD_MINUTES=5
