        <mxCell id="s1" value="1. Bắt đầu — Đăng ký tài khoản tài xế" style="ellipse;fillColor=#2d5a2d;strokeColor=#5a9a5a;fontColor=#ffffff;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="driver"><mxGeometry x="120" y="85" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="s2" value="2. Upload giấy tờ (CCCD, bằng lái, đăng ký xe, ảnh xe)" style="rounded=1;fillColor=#1e3a5f;strokeColor=#4a7ab5;fontColor=#ffffff;fontSize=11;whiteSpace=wrap;" vertex="1" parent="driver"><mxGeometry x="300" y="90" width="175" height="60" as="geometry"/></mxCell>
